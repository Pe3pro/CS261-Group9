          "mode": "raw",
          "raw": "{\n  \"name\": \"คำร้องขอฝึกสหกิจศึกษา 3/2569\",\n  \"description\": \"ทดสอบจาก Postman\",\n  \"deadline\": \"2026-12-31T23:59:00\",\n  \"fields\": [\n    {\n      \"label\": \"ชื่อ-นามสกุล\",\n      \"fieldType\": \"TEXT\",\n      \"required\": true\n    },\n    {\n      \"label\": \"ภาคการศึกษาที่ฝึก\",\n      \"fieldType\": \"SELECT\",\n      \"required\": true,\n      \"options\": \"1/2570\\n2/2570\"\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('DRAFT', () => pm.expect(j.status).to.eql('DRAFT'));",
              "pm.collectionVariables.set('formId', j.id);"
