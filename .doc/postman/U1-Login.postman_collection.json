{
  "info": {
    "_postman_id": "44539589-8a8b-477e-ba1e-f976ae50d809",
    "name": "CS261 U1 Login",
    "description": "U1:T8 ทดสอบ POST /api/auth/login\n\nก่อนรัน: docker compose up -d --build และสร้าง Environment ที่มี tu_username, tu_password (type secret)\nห้าม export Environment และห้ามบันทึก response ที่มีข้อมูลส่วนตัวไว้ใน Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PM-L01 บัญชีทดลอง staff01 (STAFF) → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('role = STAFF', () => pm.expect(r.role).to.eql('STAFF'));",
              "pm.test('มี accessToken, tokenType Bearer, userId, fullName, expiresAt', () => {",
              "  pm.expect(r.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(r.tokenType).to.eql('Bearer');",
              "  pm.expect(r.userId).to.be.a('number');",
              "  pm.expect(r.fullName).to.be.a('string').and.not.empty;",
              "  pm.expect(r.expiresAt).to.exist;",
              "});",
              "pm.test('ไม่ส่ง password กลับมา', () => pm.expect(r).to.not.have.property('password'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"staff01\",\n  \"password\": \"1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "บัญชีทดลองจาก DemoDataSeeder ไม่เรียก TU REST API"
      },
      "response": []
    },
