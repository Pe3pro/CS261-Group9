    {
      "name": "01 ดูบริษัทและจัดอันดับสำเร็จ",
      "item": [
        {
          "name": "U4-API-01 ดูบริษัทที่เปิดรับ (GET /api/companies)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{studentC}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "companies"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('ทุกบริษัทในรายการเปิดรับ (OPEN)', () => list.forEach(c => pm.expect(c.status).to.eql('OPEN')));",
                  "pm.test('มีบริษัทเปิดรับอย่างน้อย 6 แห่ง', () => pm.expect(list.length).to.be.at.least(6));",
                  "list.slice(0, 6).forEach((c, i) => pm.collectionVariables.set('c' + (i + 1), c.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "U4-API-02 บันทึกครบ 5 อันดับไม่ซ้ำ (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{studentC}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/me/company-ranking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "me",
                "company-ranking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyIds\": [{{c3}}, {{c1}}, {{c5}}, {{c2}}, {{c4}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('ได้ 5 อันดับ เรียง 1–5', () => pm.expect(r.map(x => x.rank)).to.eql([1, 2, 3, 4, 5]));",
                  "const want = ['c3', 'c1', 'c5', 'c2', 'c4'].map(k => Number(pm.collectionVariables.get(k)));",
                  "pm.test('บริษัทเรียงตามที่ส่งไป', () => pm.expect(r.map(x => x.companyId)).to.eql(want));"
                ]
              }
            }
          ]
        },
        {
          "name": "U4-API-07 ดูอันดับที่บันทึกไว้ (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{studentC}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/me/company-ranking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "me",
                "company-ranking"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('เรียงอันดับ 1–5', () => pm.expect(r.map(x => x.rank)).to.eql([1, 2, 3, 4, 5]));",
                  "pm.test('มีชื่อบริษัททุกอันดับ', () => r.forEach(x => pm.expect(x.companyName).to.be.a('string')));"
                ]
              }
            }
          ]
        }
      ]
